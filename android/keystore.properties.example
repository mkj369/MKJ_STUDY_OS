# Copy to android/keystore.properties (git-ignored) or provide the same values as
# environment variables MKJ_KEYSTORE_FILE / MKJ_KEYSTORE_PASSWORD / MKJ_KEY_ALIAS /
# MKJ_KEY_PASSWORD. Generate the key with ./scripts/generate-keystore.sh.
storeFile=/absolute/path/to/mkj-release.jks
storePassword=CHANGE_ME
keyAlias=mkj-release
keyPassword=CHANGE_ME
