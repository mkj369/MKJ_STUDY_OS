# ---------------------------------------------------------------------------
# MKJ StudyOS — client configuration (Vite exposes only VITE_* variables)
# Copy this file to `.env.local` and fill in real values.
# NEVER put service-role keys, AI provider keys or any secret in a VITE_* var:
# everything prefixed with VITE_ is bundled into the browser/mobile app.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Supabase anon / publishable key (safe for client use *only because* RLS is on)
VITE_SUPABASE_ANON_KEY=

# Optional: a label shown on the setup banner. Keep empty for production.
VITE_APP_ENV=development

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — do NOT create VITE_ variables for these.
# Set them with `supabase secrets set` (see README).
#
#   SUPABASE_URL=...                 (provided automatically by Supabase)
#   SUPABASE_ANON_KEY=...            (provided automatically by Supabase)
#   SUPABASE_SERVICE_ROLE_KEY=...    (provided automatically by Supabase)
#   AI_PROVIDER=gemini|openai
#   AI_API_KEY=...
#   AI_MODEL=gemini-2.0-flash (or gpt-4o-mini, etc.)
#   AI_TIMEOUT_MS=20000
#   AI_MAX_REQUESTS_PER_HOUR=20
# ---------------------------------------------------------------------------
