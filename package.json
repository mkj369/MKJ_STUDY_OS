{
  "name": "mkj-studyos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MKJ StudyOS \u2014 personal academic memory, syllabus tracker and study planner for HSC Science students.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:e2e": "playwright test",
    "test:db": "vitest run tests/db",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@hookform/resolvers": "^3.10.0",
    "@ionic/react": "^8.8.19",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "date-fns": "^4.4.0",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
